$
  f(x) = y \
  f^(-1)(y) = x \
  f(f^(-1)(y)) = y \
$

$  
  "let" f(a)*f(b) = f(a+b) \
  #[i.e. $10^a*10^b = 10^(a+b), f(x)=10^x$] \
  "let" m =f^(-1)(f(a)*f(b)) = a+b \
  "let" a = f^(-1)(c) \
  "let" b = f^(-1)(d) \
  m =f^(-1)(c*d) = f^(-1)(c)+f^(-1)(d) \
$

$
  "let" f(a)/f(b) = f(a-b) \
  "let" m =f^(-1)(f(a)/f(b)) = a-b \
  "let" a = f^(-1)(c) \
  "let" b = f^(-1)(d) \
  m =f^(-1)(c/d) = f^(-1)(c)-f^(-1)(d) \
$   

  the rules of a inverse function can be derived from its non-inverse and vice-versa
  
  
  

